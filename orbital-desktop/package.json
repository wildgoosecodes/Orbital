{
  "name": "orbital-desktop",
  "version": "0.1.0",
  "description": "Orbital's desktop companion — a spoken daily briefing, with a real voice assistant planned for later phases.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.orbital.desktop",
    "productName": "Orbital Desktop",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "briefing.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  }
}
